<?xml version="1.0" encoding="utf-8"?>
<!-- Anteprima nel selettore dei widget (Android 12+), con dati di esempio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_preview_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_preview_header" android:backgroundTint="#FF0D2F8C"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_tab_station" android:tint="#FFFFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ROMA TERMINI" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Partenze" android:textColor="#DDFFFFFF" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_widget_refresh" android:tint="#FFFFFFFF" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="11:42" android:textColor="@color/widget_fg" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NAPOLI CENTRALE" android:textColor="@color/widget_fg" android:textSize="13sp" android:maxLines="1" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="IC 723" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF2E7D32"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="in orario" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF2E7D32"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bin. 4" android:textColor="#FFFFD54F" android:textSize="11sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF263238"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="11:50" android:textColor="@color/widget_fg" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MILANO CENTRALE" android:textColor="@color/widget_fg" android:textSize="13sp" android:maxLines="1" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FR 9615" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FFC8102E"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="+6\'" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FFC62828"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bin. 6" android:textColor="#FFFFD54F" android:textSize="11sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF263238"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12:03" android:textColor="@color/widget_fg" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="FIRENZE S.M.N." android:textColor="@color/widget_fg" android:textSize="13sp" android:maxLines="1" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ES 9521" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF1F4E9C"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="in orario" android:textColor="#FFFFFFFF" android:textSize="10sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF2E7D32"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bin. 3" android:textColor="#FFFFD54F" android:textSize="11sp" android:textStyle="bold"
                android:background="@drawable/widget_preview_chip" android:backgroundTint="#FF263238"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:layout_marginEnd="4dp" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" />
    </LinearLayout>
</LinearLayout>
